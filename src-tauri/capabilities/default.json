{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
              { "url": "http://192.168.*" },
              { "url": "http://10.*" }
            ]
    },
    "http:default"
  ]
}
